<%= form_with(model: make, class: "resource__form") do |form| %>
  <% if make.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(make.errors.count, "error") %> prohibited this make from being saved:</h2>

      <ul>
        <% make.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="resource__form__field">
    <%= form.label :name, class: "resource__form__label" %>
    <%= form.text_field :name, class: "resource__form__input" %>
  </div>

  <div class="resource__form__actions resource__form__actions--right">
    <%= form.submit "Save", { class: "btn btn--primary" } %>
  </div>
<% end %>
