<%= render "shared/notice" %>

<nav class="resource__header">
  <%= link_to makes_path, class: "link link--breadcrumb" do %>
    <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M19 12H5M5 12L12 19M5 12L12 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span>All makes</span>
  <% end %>
</nav>

<section class="resource__show">
  <h1 class="resource__title"><%= @make.name %></h1>
   <% if @make.models.any? %>
    <section class="resource__attributes">
      <h2 class="resource__attribute__title">
        <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2C12.5917 2 13.1713 2.05139 13.7348 2.14994M12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22M12 2V22M17.738 3.809C18.6922 4.47869 19.5241 5.31089 20.1934 6.26541M21.8501 10.2656C21.9486 10.8289 22 11.4085 22 12C22 12.5915 21.9486 13.1711 21.8501 13.7344M20.1892 17.7406C19.5203 18.693 18.6896 19.5233 17.7369 20.1917M13.7328 21.8504C13.17 21.9487 12.591 22 12 22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Associated models
      </h2>
      <% @make.models.each do |model| %>
        <% if model.name.present? %>
          <p class="resource__attribute">
            <%= model.name %>
          </p>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <footer class="resource__footer">
    <%= button_to "Remove", @make, method: :delete, class: "btn btn--delete", form: { data: { turbo_confirm: "Are you sure you want to delete #{@make.name}?" } } %>
    <%= link_to "Edit", edit_make_path(@make), class: "btn btn--primary" %>
  </footer>
</section>
