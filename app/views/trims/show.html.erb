<p style="color: green"><%= notice %></p>

<nav class="resource__header">
  <%= link_to trims_path, class: "link link--breadcrumb" do %>
    <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M19 12H5M5 12L12 19M5 12L12 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span>All trims</span>
  <% end %>
</nav>

<section class="resource__show">
  <h1 class="resource__title"><%= @trim.name %></h1>

  <footer class="resource__footer">
    <%= button_to "Remove", @trim, method: :delete, class: "btn btn--delete", form: { data: { turbo_confirm: "Are you sure you want to delete #{@trim.name}?" } } %>
    <%= link_to "Edit", edit_trim_path(@trim), class: "btn btn--primary" %>
  </footer>
</section>
