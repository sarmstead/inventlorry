<%= form_with(model: trim, class: "resource__form") do |form| %>
  <% if trim.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(trim.errors.count, "error") %> prohibited this trim from being saved:</h2>

      <ul>
        <% trim.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="resource__form__field">
    <%= form.label :name, class: "resource__form__label" %>
    <%= form.text_field :name, class: "resource__form__input" %>
  </div>

  <div class="resource__form__field resource__form__field--select">
    <%= form.label :model_id, class: "resource__form__label" %>
    <%= form.select :model_id, models, { include_blank: "-- select model --" }, { class: "resource__form__select", required: true } %>
  </div>

  <div class="resource__form__actions resource__form__actions--right">
    <%= form.submit "Save", { class: "btn btn--primary" } %>
  </div>
<% end %>

