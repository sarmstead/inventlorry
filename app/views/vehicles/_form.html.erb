<%= form_with(model: vehicle, class: "resource__form", data: { controller: "vehicle", vehicle_initial_make_value: vehicle&.make&.id, vehicle_initial_model_value: vehicle&.model&.id, vehicle_initial_trim_value: vehicle&.trim&.id }) do |form| %>
  <% if vehicle.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(vehicle.errors.count, "error") %> prohibited this vehicle from being saved:</h2>

      <ul>
        <% vehicle.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="resource__form__field">
    <%= form.label :name, class: "resource__form__label" %>
    <%= form.text_field :name, class: "resource__form__input" %>
  </div>

  <div class="resource__form__field-group">
    <div class="resource__form__field resource__form__field--select">
      <%= form.label :make_id, class: "resource__form__label" %>
      <%= form.select :make_id, makes, { include_blank: "-- select make --" }, { required: true, class: "resource__form__select", data: { vehicle_target: "make", action: "change->vehicle#selectMake" }} %>
    </div>

    <div class="resource__form__field resource__form__field--select">
      <%= form.label :model_id, class: "resource__form__label" %>
      <%= form.select :model_id, [], { include_blank: "-- select model --" }, { required: true, class: "resource__form__select", disabled: true, data: { vehicle_target: "model", action: "change->vehicle#selectModel" } } %>
    </div>

    <div class="resource__form__field resource__form__field--select">
      <%= form.label :trim_id, class: "resource__form__label" %>
      <%= form.select :trim_id, [], { include_blank: "-- select trim --" }, { required: true, class: "resource__form__select", disabled: true, data: { vehicle_target: "trim", action: "change->vehicle#selectTrim" } } %>
    </div>
  </div>

  <div class="resource__form__actions resource__form__actions--right">
    <button class="btn btn--secondary">Reset</button>
    <%= form.submit "Save", { class: "btn btn--primary", disabled: true, data: { vehicle_target: "create" }} %>
  </div>
<% end %>
