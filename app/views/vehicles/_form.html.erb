<%= form_with(model: vehicle, data: { controller: "vehicle" }) do |form| %>
  <% if vehicle.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(vehicle.errors.count, "error") %> prohibited this vehicle from being saved:</h2>

      <ul>
        <% vehicle.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :make_id, style: "display: block" %>
    <%= form.select :make_id, [["-- select make --", -1]].concat(Make.all.map {|m| [m.name, m.id]}), {}, { data: { vehicle_target: "make", action: "change->vehicle#selectMake" }} %>
  </div>

  <div>
    <%= form.label :model_id, style: "display: block" %>
    <%= form.select :model_id, [["-- select model --", -1]], {}, { disabled: true, data: { vehicle_target: "model", action: "change->vehicle#selectModel" } } %>
  </div>

  <div>
    <%= form.label :trim_id, style: "display: block" %>
    <%= form.select :trim_id, [["-- select trim --", -1]], {}, { disabled: true, data: { vehicle_target: "trim", action: "change->vehicle#selectTrim" } } %>
  </div>

  <div>
    <%= form.submit "Create vehicle", { disabled: true, data: { vehicle_target: "create" }} %>
    <button>Reset</button>
  </div>
<% end %>
