<%= render "shared/notice" %>

<% content_for :title, "Models" %>
<% content_for :body_class, "resource__index" %>

<header class="resource__header">
  <h1 class="resource__title">Models</h1>
  <%= link_to "New model", new_model_path, class: "btn btn--primary" %>
</header>

<% if @models.any? %>
  <div id="models">
    <div class="resource__table__container">
      <table class="resource__table">
        <thead class="resource__table__thead">
          <tr>
            <th class="resource__table__th">Name</th>
            <th class="resource__table__th">Last updated</th>
            <th class="resource__table__th resource__actions" arial-label="Model actions"></th>
          </tr>
        </thead>
        <tbody class="resource__table__tbody">
          <% @models.each do |model| %>
            <%= render model %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <%= render "shared/empty", resource: Model %>
<% end %>
